# CICIDS2017 Dataset
MachineLearningCVE/
MachineLearningCSV.zip
*.csv

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Datasets - too large for git, and raw data should never be committed
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained models - large binary files, regenerate instead of committing
models/*.pkl
models/*.joblib
!models/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep
logs/*.db


# Secrets
.env

# OS / editor
.DS_Store
.vscode/
.idea/

